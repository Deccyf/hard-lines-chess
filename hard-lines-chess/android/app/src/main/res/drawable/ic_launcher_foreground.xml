<?xml version="1.0" encoding="utf-8"?>
<!-- The mark: a two-by-two board in the app's default board colours, on a
     deep blue ground. The same mark tools/make-icons.cjs draws for the web
     icons, as a vector so no PNG has to be kept in step at four densities.

     THE 24..84 BOX IS THE SAFE ZONE. An adaptive icon is a 108x108 canvas that
     every launcher crops to its own shape, and only the middle 72 survives all
     of them. The web maskable icon insets the mark by 22% for the same reason. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#1b2a44"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Rounded corners on the mark itself, as in the app's header. -->
    <path
        android:fillColor="#eeeed2"
        android:pathData="M30,24h24v30h-30v-24a6,6 0 0 1 6,-6z" />
    <path
        android:fillColor="#769656"
        android:pathData="M54,24h24a6,6 0 0 1 6,6v24h-30z" />
    <path
        android:fillColor="#769656"
        android:pathData="M24,54h30v30h-24a6,6 0 0 1 -6,-6z" />
    <path
        android:fillColor="#eeeed2"
        android:pathData="M54,54h30v24a6,6 0 0 1 -6,6h-24z" />
</vector>
