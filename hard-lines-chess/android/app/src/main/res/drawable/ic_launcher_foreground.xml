<?xml version="1.0" encoding="utf-8"?>
<!-- The Hard Lines mark: a two-by-two checker, bone and vermilion, on ink.
     The same mark tools/make-icons.cjs draws for the web icons, as a vector so
     no PNG has to be kept in step with it at four densities.

     THE 24..84 BOX IS THE SAFE ZONE. An adaptive icon is a 108x108 canvas that
     every launcher crops to its own shape, and only the middle 72 survives all
     of them. The web maskable icon insets the mark by 22% for the same reason;
     this is that inset, in the units Android uses. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ink ground, filling the whole canvas so the crop never cuts into
         a corner that has nothing behind it. -->
    <path
        android:fillColor="#14110d"
        android:pathData="M0,0h108v108h-108z" />

    <path
        android:fillColor="#fbfaf7"
        android:pathData="M24,24h30v30h-30z" />
    <path
        android:fillColor="#e8412a"
        android:pathData="M54,24h30v30h-30z" />
    <path
        android:fillColor="#e8412a"
        android:pathData="M24,54h30v30h-30z" />
    <path
        android:fillColor="#fbfaf7"
        android:pathData="M54,54h30v30h-30z" />
</vector>
