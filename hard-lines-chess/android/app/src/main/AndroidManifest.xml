<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ONE PERMISSION TO CONNECT, FOR ONE THING: reading Chess.com's public archive of a
         player's games, so that new games arrive without being typed in.

         Until version 1.6 the app held no INTERNET permission at all, and the
         claim that everything runs on your own device was enforced by the
         system. The permission cannot be granted for one address, so what
         keeps it to one is in the app, twice over, and tested:

           - MainActivity answers every request the page makes from the APK,
             lets through a GET to https://api.chess.com/pub/player/… and
             nothing else, and refuses the rest;
           - every page it serves carries a policy that lets the page connect
             to where it came from and to that host only, which also covers
             what the first cannot see.

         The app still has no accounts, no sync and no telemetry, and sends
         nothing but the player's name, to Chess.com. Everything except that
         import works with no connection. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AND TWO FOR THE DAILY REMINDER, which is off until it is turned on in
         the app.

         POST_NOTIFICATIONS is what lets the app show it. Android asks the
         person whether to allow that, and the app asks Android only at the
         moment the reminder is turned on; until then the permission is
         declared here and has never been used.

         RECEIVE_BOOT_COMPLETED lets the app hear that the phone has
         restarted, which clears every alarm, so that the reminder can be set
         again. It reads nothing and shows nothing by itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.HardLines">

        <!-- Rotating the phone, or the system flipping to dark at sunset, must
             not restart the activity: a restart reloads the page and the game
             on the board goes with it. MainActivity handles the two things
             that genuinely change in onConfigurationChanged. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The reminder's alarm, and the two moments it has to be set again:
             the phone restarting and the app being updated. Not exported: the
             alarm is the app's own and the other two come from the system. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
